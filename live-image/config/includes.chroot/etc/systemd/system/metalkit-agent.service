[Unit]
Description=metalkit inventory agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/metalkit-agent
# The agent owns its own retry loop with exponential backoff. If it exits at all
# (e.g. SMBIOS UUID empty, controller URL missing) we let systemd restart it
# with a backoff so it does not chew CPU on a permanent failure.
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
